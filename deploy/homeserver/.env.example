# /srv/devcookie/.env 로 복사해서 채운다 (chmod 600). 저장소에 올리지 않는다.

# 그램 서버 PostgreSQL 비밀번호. 각각 openssl rand -hex 24 로 만든다(영문 · 숫자만: 연결 주소에 그대로 들어간다)
POSTGRES_PASSWORD=
PROD_DB_PASSWORD=
STAGING_DB_PASSWORD=

# DB 백업 복사본을 둘 다른 디스크(외장 디스크 · NAS 마운트 경로). 비우면 노트북 안(/srv/devcookie/backups)에만 남는다
BACKUP_COPY_DIR=

# Neon에서 데이터를 옮길 때만 잠깐 넣는다(migrate-from-neon.sh). 옮긴 뒤에는 지운다
NEON_PROD_URL=
NEON_STAGING_URL=

# 관리자 페이지 키. 운영과 스테이징에 서로 다른 32자 이상 무작위 값 (openssl rand -hex 24)
PROD_ADMIN_KEY=
STAGING_ADMIN_KEY=

# Cloudflare Zero Trust → Networks → Tunnels → 터널 → 설치 명령에 나오는 토큰
TUNNEL_TOKEN=

# 소셜 · 깃허브 로그인 (비우면 그 버튼만 숨겨진다). 리디렉션 주소는 https://mycookie.dev/auth/callback (스테이징은 https://staging.mycookie.dev/auth/callback)
# state 서명 키: openssl rand -hex 24
OAUTH_STATE_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# 비밀번호 재설정 · 이메일 인증 메일을 보낼 SMTP 서버 (비우면 메일 기능만 꺼진다)
# 온프레미스 메일 서버, 사내 SMTP 릴레이, 또는 외부 SMTP(예: smtp.gmail.com + 앱 비밀번호) 아무거나 된다
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 보내는 사람 주소 (예: 나의쿠키 <no-reply@mycookie.dev>). 대부분의 SMTP는 MAIL_USERNAME과 같은 도메인이어야 한다
MAIL_FROM=

# Mattermost 채널에 오늘의 CS 질문 올리기 (운영 서버만 사용, 비우면 꺼진다)
# 채널 메뉴 → 통합 → 수신 웹훅 → 추가 로 만든 URL (https://meeting.ssafy.com/hooks/...)
MATTERMOST_WEBHOOK_URL=
# 초 분 시 일 월 요일 (한국 시간). 기본: 평일 8시 30분
MATTERMOST_CRON=0 30 8 * * MON-FRI

# 학습 메일 구독 (MAIL_HOST가 있어야 켜진다). 무료 SMTP 하루 한도보다 낮게 둔다(Gmail 약 500통)
NEWSLETTER_DAILY_LIMIT=400
NEWSLETTER_CRON=0 30 8 * * MON-FRI
