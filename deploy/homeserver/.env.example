# /srv/devcookie/.env 로 복사해서 채운다 (chmod 600). 저장소에 올리지 않는다.

# Neon 연결 문자열 (postgresql://...). 운영은 main, 스테이징은 staging 브랜치
PROD_DATABASE_URL=
STAGING_DATABASE_URL=

# 관리자 페이지 키. 운영과 스테이징에 서로 다른 32자 이상 무작위 값 (openssl rand -hex 24)
PROD_ADMIN_KEY=
STAGING_ADMIN_KEY=

# Cloudflare Zero Trust → Networks → Tunnels → 터널 → 설치 명령에 나오는 토큰
TUNNEL_TOKEN=

# 소셜 · 깃허브 로그인 (비우면 그 버튼만 숨겨진다). 리디렉션 주소는 https://mycookie.dev/auth/callback
# state 서명 키: openssl rand -hex 24
OAUTH_STATE_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
