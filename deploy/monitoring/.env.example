# 로그 모니터링(Grafana + Loki + Alloy) 설정. /srv/mycookie-monitoring/.env로 복사해 쓴다(chmod 600)
# Grafana 관리자 비밀번호(필수). 긴 무작위 값으로
GRAFANA_ADMIN_PASSWORD=
# Grafana 관리자 아이디(기본 admin)
GRAFANA_ADMIN_USER=
# 보기 전용 팀원 계정. "아이디:비밀번호" 여러 개는 띄어쓰기로 구분. up.sh가 없으면 만든다(첫 로그인 뒤 비밀번호를 바꾸게 한다)
GRAFANA_VIEWERS=
# 브라우저로 여는 Grafana 주소(Tailscale 이름). 예: http://desktop-fegqjr8:3000
GRAFANA_ROOT_URL=
# Loki, Grafana, Alloy 데이터를 둘 폴더(기본 /srv/mycookie-monitoring)
MONITORING_DATA=
