<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 설정.
  - 콘솔: 항상 출력한다(Render · Docker 로그 그대로).
  - 파일: file-log 프로필을 켰을 때만 레벨별로 나눠 저장한다(홈서버용).
      error.log · warn.log · info.log · debug.log : 해당 레벨만
      app.log                                     : 전체
    날짜 · 크기별로 나눠 gzip으로 보관하고, 오래된 파일은 지운다.
  위치는 LOG_PATH(기본 ./logs), 보관 일수는 LOG_MAX_HISTORY(기본 30일, 에러는 LOG_ERROR_MAX_HISTORY 기본 90일).
  debug.log는 패키지 로그 레벨을 DEBUG로 낮췄을 때만 채워진다(예: LOGGING_LEVEL_COM_CSSTUDY=DEBUG).
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <springProperty scope="context" name="LOG_DIR" source="logging.file.path" defaultValue="logs"/>
  <property name="MAX_HISTORY" value="${LOG_MAX_HISTORY:-30}"/>
  <property name="ERROR_MAX_HISTORY" value="${LOG_ERROR_MAX_HISTORY:-90}"/>
  <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Seoul} %-5level [%thread] %logger{40} : %msg%n"/>

  <springProfile name="file-log">
    <!-- 레벨 하나만 받는 파일. name=파일 이름, level=받을 레벨 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/error.log</file>
      <filter class="ch.qos.logback.classic.filter.LevelFilter"><level>ERROR</level><onMatch>ACCEPT</onMatch><onMismatch>DENY</onMismatch></filter>
      <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archive/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>50MB</maxFileSize>
        <maxHistory>${ERROR_MAX_HISTORY}</maxHistory>
        <totalSizeCap>1GB</totalSizeCap>
      </rollingPolicy>
    </appender>

    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/warn.log</file>
      <filter class="ch.qos.logback.classic.filter.LevelFilter"><level>WARN</level><onMatch>ACCEPT</onMatch><onMismatch>DENY</onMismatch></filter>
      <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archive/warn.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>50MB</maxFileSize>
        <maxHistory>${MAX_HISTORY}</maxHistory>
        <totalSizeCap>1GB</totalSizeCap>
      </rollingPolicy>
    </appender>

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/info.log</file>
      <filter class="ch.qos.logback.classic.filter.LevelFilter"><level>INFO</level><onMatch>ACCEPT</onMatch><onMismatch>DENY</onMismatch></filter>
      <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archive/info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>100MB</maxFileSize>
        <maxHistory>${MAX_HISTORY}</maxHistory>
        <totalSizeCap>2GB</totalSizeCap>
      </rollingPolicy>
    </appender>

    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/debug.log</file>
      <filter class="ch.qos.logback.classic.filter.LevelFilter"><level>DEBUG</level><onMatch>ACCEPT</onMatch><onMismatch>DENY</onMismatch></filter>
      <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archive/debug.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>100MB</maxFileSize>
        <maxHistory>7</maxHistory>
        <totalSizeCap>1GB</totalSizeCap>
      </rollingPolicy>
    </appender>

    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/app.log</file>
      <encoder><pattern>${FILE_PATTERN}</pattern><charset>UTF-8</charset></encoder>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archive/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>100MB</maxFileSize>
        <maxHistory>${MAX_HISTORY}</maxHistory>
        <totalSizeCap>3GB</totalSizeCap>
      </rollingPolicy>
    </appender>

    <!-- 파일 쓰기가 요청 처리를 붙잡지 않게 비동기로 쓴다. 에러 · 경고는 큐가 차도 버리지 않는다 -->
    <appender name="ASYNC_ALL" class="ch.qos.logback.classic.AsyncAppender">
      <queueSize>2048</queueSize>
      <discardingThreshold>0</discardingThreshold>
      <neverBlock>true</neverBlock>
      <appender-ref ref="ALL_FILE"/>
    </appender>
    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
      <queueSize>2048</queueSize>
      <neverBlock>true</neverBlock>
      <appender-ref ref="INFO_FILE"/>
    </appender>
    <appender name="ASYNC_DEBUG" class="ch.qos.logback.classic.AsyncAppender">
      <queueSize>2048</queueSize>
      <neverBlock>true</neverBlock>
      <appender-ref ref="DEBUG_FILE"/>
    </appender>
  </springProfile>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <springProfile name="file-log">
      <appender-ref ref="ERROR_FILE"/>
      <appender-ref ref="WARN_FILE"/>
      <appender-ref ref="ASYNC_INFO"/>
      <appender-ref ref="ASYNC_DEBUG"/>
      <appender-ref ref="ASYNC_ALL"/>
    </springProfile>
  </root>
</configuration>
