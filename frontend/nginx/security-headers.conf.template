# 모든 응답에 붙이는 보안 헤더. scripts/export-nginx-headers.mjs가 vercel.json에서 만든다(직접 고치지 않는다)
add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://js.tosspayments.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https://static.solved.ac https://static.toss.im https://*.tosspayments.com; connect-src 'self' https://*.tosspayments.com; media-src 'self' blob: data:; frame-src 'self' blob: https://*.tosspayments.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Robots-Tag "${ROBOTS_HEADER}" always;
